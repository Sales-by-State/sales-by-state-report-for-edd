<?xml version="1.0"?>
<ruleset name="Sales by State Report for Easy Digital Downloads">
	<description>WordPress Coding Standards for Sales by State Report for Easy Digital Downloads.</description>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<exclude-pattern>/assets/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>

	<!--
	Classes under src/ are PSR-4 autoloaded via the SBSEDD\ namespace (see the
	spl_autoload_register() call in the main plugin file), so file names
	match their class names (Page.php, Controller.php, ...) rather than the
	legacy class-foo.php convention this sniff expects.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="view_shop_reports"/>
				<element value="manage_shop_settings"/>
			</property>
		</properties>
	</rule>
</ruleset>
